process {
    resourceLimits = [
        memory: 28.GB,   // leave a few GB headroom for your OS
        cpus: 8,
        time: 240.h
    ]


    withName: 'MEGAHIT' {
        ext.args = {
            [
                '--preset meta-sensitive',
                '--min-contig-len 10'
            ].join(' ')
        }

    }
}

profiles {
    local {
        process.executor = 'local'
        executor {
            cpus = 16
            memory = 48.GB
        }
    }
    k8s_cluster {
        process.executor = 'k8s'
        executor {
            queueSize = 8
        }
    }
}

